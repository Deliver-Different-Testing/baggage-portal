{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://baggagedelivery.local.deliverdifferent.com:5297",
      "sslPort": 0
    }
  },
  "profiles": {
    "BaggageDelivery.Api": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://baggagedelivery.local.deliverdifferent.com:5298",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_HOSTINGSTARTUPASSEMBLIES": "Microsoft.AspNetCore.SpaProxy",
        "ConnectionStrings__DefaultConnection": "Server=<host>\\<instance>;Database=<db>;uid=<user>;pwd=<password>;TrustServerCertificate=True;",
        "SQLCredentials": "uid=<user>;pwd=<password>",
        "PublicPath": "https://hub.local.deliverdifferent.com/Account/login",
        "Domain": "local.deliverdifferent.com",
        "HereMaps__ApiKey": "<here-maps-api-key>",
        "TrackingPageUrl": "http://tracking.local.deliverdifferent.com/",
        "JWTSecretKey": "<base64-jwt-secret>",
        "Issuer": "http://api.local.deliverdifferent.com/",
        "Audience": "DeliverDifferent.com",
        "BaggageDeliveryEncryptionKey": "<base64-32-byte-key>",
        "BaggageDeliveryEncryptionIV": "<base64-16-byte-iv>",
        "AWS_REGION": "ap-southeast-2",
        "TimeZone": "Pacific/Auckland"
      }
    }
  }
}
